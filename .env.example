# Copy to .env for local development. Never commit real secrets.
ENV=development
DEBUG=true
PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:4321,https://rintuchowdory.github.io

# Optional: read real workflow runs for /api/v1/pipelines.
# Without it the endpoint serves the demo store and reports source="simulated".
# GITHUB_TOKEN=ghp_xxx
# GITHUB_REPOS=rintuchowdory/devops-portfolio-microservice,rintuchowdory/devops-portfolio-website
# PIPELINES_SOURCE=auto
